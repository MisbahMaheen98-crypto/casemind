# ==============================================================================
# CASEMIND Environment Configuration
# ==============================================================================

# Hindsight Semantic Memory Layer (Optional)
# If provided, CASEMIND connects to the Hindsight API memory service.
# If omitted or invalid, CASEMIND automatically falls back to the embedded
# Local Persistent Memory Adapter in Demo Mode without crashing.
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io/v1

# Application Settings
NODE_ENV=development
PORT=3000
